<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Sample Model List View -->
        <record id="view_clarence_demo_sample_list" model="ir.ui.view">
            <field name="name">Sample Model List</field>
            <field name="model">clarence.demo.sample</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="created_date" />
                    <field name="active" />
                </tree>
            </field>
        </record>

        <!-- Sample Model Form View -->
        <record id="view_clarence_demo_sample_form" model="ir.ui.view">
            <field name="name">Sample Model Form</field>
            <field name="model">clarence.demo.sample</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="description" />
                            <field name="active" />
                            <field name="created_date" />
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <!-- Sample Model Action -->
        <record id="action_clarence_demo_sample" model="ir.actions.act_window">
            <field name="name">Sample</field>
            <field name="res_model">clarence.demo.sample</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first sample record.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem
            id="menu_clarence_demo_root"
            name="Clarence Demo"
            sequence="100"
        />
        <menuitem
            id="menu_clarence_demo_sample"
            name="Sample"
            action="action_clarence_demo_sample"
            parent="menu_clarence_demo_root"
            sequence="10"
        />

    </data>
</odoo>
